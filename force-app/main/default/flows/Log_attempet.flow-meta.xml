   ISBLANK({!get_Current_Task.Log_Notes__c}),
   &quot;Logged on &quot; &amp; TEXT(TODAY()) &amp; &quot; - &quot; &amp; {!Log_Notes},
   SUBSTITUTE({!get_Current_Task.Log_Notes__c}, &quot;&lt;br&gt;&quot;, &quot;, &quot;)
   &amp; &quot;, &quot; &amp;
   &quot;Logged on &quot; &amp; TEXT(TODAY()) &amp; &quot; - &quot; &amp; {!Log_Notes}
)</expression>
