    <formulas>
        <name>Counter</name>
        <dataType>Number</dataType>
        <expression>IF(
   ISBLANK({!get_Current_Task.Log_Notes__c}),
   1,
   {!get_Current_Task.Number_of_Attempts__c} + 1
)</expression>
